+	config := &model.TOTPConfiguration{ID: 1, Username: testUsername, Digits: 6, Secret: []byte("secret"), Period: 30, Algorithm: "SHA1"}
+
+	s.setFailingSessionBackend(nil, errors.New("session regenerate failed"))
